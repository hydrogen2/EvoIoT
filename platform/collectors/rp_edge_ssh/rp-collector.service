[Unit]
Description=EvoIoT RP edge SSH collector (incremental telemetry pull → MQTT)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/supper-user/EvoIoT/platform
EnvironmentFile=/home/supper-user/EvoIoT/platform/collectors/rp_edge_ssh/.env
ExecStart=/home/supper-user/.evoiot-e2e-venv/bin/python collectors/rp_edge_ssh/collect.py --all --loop --interval 60 --window 10m
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
