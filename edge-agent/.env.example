# EvoIoT Edge Agent — real deployment config
# Copy to .env on the edge device and fill in.

# Tenant/building this agent belongs to (becomes tenant_id on the platform)
TENANT_ID=

# Unique name for this agent (multiple agents per building are fine)
AGENT_ID=agent-001

# This device's own IP on the BACnet/IP network and its subnet prefix length.
# BAC0 binds to this address for Who-Is broadcasts and polling.
BACNET_IP=
BACNET_SUBNET=24

# The platform's Mosquitto broker, reachable from this device
# e.g. tcp://10.65.18.104:1883
MQTT_URL=

# Polling cadence (seconds)
POLL_INTERVAL=60
DISCOVERY_INTERVAL=300

LOG_LEVEL=INFO
